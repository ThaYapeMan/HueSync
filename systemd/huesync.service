[Unit]
Description=HueSync - spectrum-reactive Hue lighting from LMS and AirPlay
After=network-online.target shairport-sync.service
Wants=network-online.target

[Service]
Type=simple
User=huesync
Group=huesync
UMask=0077
WorkingDirectory=/opt/huesync
Environment=HUESYNC_CONFIG=/etc/huesync/config.json
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin
Environment=PYTHONDONTWRITEBYTECODE=1
SupplementaryGroups=audio

ExecStart=/opt/huesync/.venv/bin/huesync
Restart=on-failure
RestartSec=5

# squeezelite/cava write to /dev/shm and spawn subprocesses - keep
# sandboxing light rather than fighting it for a first version.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
